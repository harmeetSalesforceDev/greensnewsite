<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>glBarristerBanner</masterLabel>
    <description>Barristers page banner with heading and intro text</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="eyebrow" type="String" label="Eyebrow" default="Our Barristers" />
            <property name="headingMain" type="String" label="Heading" default="Exceptional advocates." />
            <property name="headingAccent" type="String" label="Heading (green italic)" default="Distinct expertise." />
            <property name="description" type="String" label="Description" default="Search the List by name or expertise, or ask our clerking team to help match the right counsel to your matter." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>